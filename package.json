{
  "name": "wf2-telemetry",
  "version": "2.1.0",
  "description": "Wreckfest 2 telemetry capture — records a session to a .jsonl log from SimHub's UDP forward",
  "main": "lib/index.js",
  "bin": {
    "wf2-record": "record.js",
    "wf2-telemetry-config": "tools/telemetry.js"
  },
  "files": [
    "record.js",
    "lib/",
    "tools/",
    "FORMAT.md"
  ],
  "scripts": {
    "test": "node verify.js",
    "build": "node tools/build-exe.js",
    "release": "node tools/build-exe.js && node verify.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "wreckfest",
    "telemetry",
    "simhub",
    "sim-racing"
  ],
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
